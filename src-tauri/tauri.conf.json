{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SE Grid Builder",
  "version": "1.0.1",
  "identifier": "com.segridbuilder.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SE Grid Builder",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyMEM2MzRFQkZBRDE0NEMKUldSTUZLMi9UbU1NZ3NVV1Q2RzRuVndRcU9RK0ZRL0tGd2JJRGNnRzZMclRwSlJTM0trNVZEQzAK",
      "endpoints": [
        "https://github.com/PhonicSpider/SE-Grid-Builder/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
